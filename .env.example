# ---------------------------------------------------------------------------
# Nightshift Security — example environment. Copy to .env and fill in.
# NEVER commit .env. NEVER put XVR credentials here (see edge secret store).
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Cloud backend -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nightshift:nightshift@postgres:5432/nightshift
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://nightshift:nightshift@rabbitmq:5672//

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Object storage (S3 compatible / MinIO in dev) ---------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nightshift-media
S3_ACCESS_KEY=nightshift
S3_SECRET_KEY=nightshift-secret
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# --- Push --------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON_PATH=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
APNS_USE_SANDBOX=true

# --- Services ----------------------------------------------------------------
MEDIA_GATEWAY_URL=http://mediamtx:9997
MEDIA_GATEWAY_API_USER=api
MEDIA_GATEWAY_API_PASSWORD=
MEDIA_GATEWAY_PUBLISH_USER=edge
MEDIA_GATEWAY_PUBLISH_PASSWORD=
AI_SERVICE_URL=http://ai-service:8100

# --- Billing -----------------------------------------------------------------
BILLING_PROVIDER=noop
BILLING_SECRET=

# --- Edge agent (per-gateway; keep on the gateway, not in cloud) --------------
EDGE_ID=
EDGE_DATA_DIR=/var/lib/nightshift-edge
EDGE_CLOUD_URL=https://api.nightshift.local
EDGE_ENROLLMENT_TOKEN=
EDGE_MAX_SPOOL_GB=10
EDGE_LOG_LEVEL=INFO
# Master key for the local encrypted secret store (Fernet, base64 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
EDGE_SECRET_KEY=

# --- AI service --------------------------------------------------------------
AI_PROVIDER=stub
AI_MODEL_DIR=/models
